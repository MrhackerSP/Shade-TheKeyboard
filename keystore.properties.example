# Template for release signing — copy to keystore.properties (git-ignored) and
# fill in your own values. Read by app/build.gradle.kts; without this file the
# release build falls back to the debug keystore (CI-safe, but do not publish
# a store release signed with the debug key).
#
# Generate a keystore:
#   keytool -genkeypair -v -keystore shade-release.keystore \
#     -alias shade -keyalg RSA -keysize 4096 -validity 10000
#
# KEEP A BACKUP OF THIS KEYSTORE AND ITS PASSWORDS. Losing the key means the
# app can never be updated in place (Android refuses mismatched signatures).
storeFile=shade-release.keystore
storePassword=CHANGE_ME
keyAlias=shade
keyPassword=CHANGE_ME
