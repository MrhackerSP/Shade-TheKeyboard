<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+).

    Shade is an IME — it must never back up or transfer the user's typing
    data (learned words, autocorrect history, clipboard, typing stats) to
    Google Drive or to a new device. Both `allowBackup` and
    `fullBackupContent` are already false in the manifest; this file makes
    the Android 12+ "device-to-device transfer" path explicit too.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
