<?xml version="1.0" encoding="utf-8"?>
<!-- Switch thumb: dark disc on the white track, grey disc on the outlined track. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:state_checked="true" android:color="#555555" />
    <item android:state_enabled="false" android:color="#3A3A3A" />
    <item android:state_checked="true" android:color="@color/noir_switch_on_thumb" />
    <item android:color="@color/noir_switch_off_thumb" />
</selector>
