<?xml version="1.0" encoding="utf-8"?>
<!-- Tint of the check / X glyph inside the switch thumb. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:state_checked="true" android:color="#9A9A9A" />
    <item android:state_enabled="false" android:color="#111111" />
    <item android:state_checked="true" android:color="@color/noir_switch_on_icon" />
    <item android:color="@color/noir_switch_off_icon" />
</selector>
