<?xml version="1.0" encoding="utf-8"?>
<!-- Switch track fill: white when on, near-black when off (the outline is drawn by the track decoration). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:state_checked="true" android:color="#2E2E2E" />
    <item android:state_enabled="false" android:color="#111111" />
    <item android:state_checked="true" android:color="@color/noir_switch_on_track" />
    <item android:color="@color/noir_switch_off_track" />
</selector>
