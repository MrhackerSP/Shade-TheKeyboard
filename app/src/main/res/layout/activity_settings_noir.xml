<?xml version="1.0" encoding="utf-8"?>
<!--
  Shade settings — Noir.
  Pitch-black canvas, white type, hairline dividers. A compact pinned header
  (title + version, then search) above one flat RecyclerView of collapsible
  sections. No cards, no icons, no page navigation.
-->
<!-- Explicit background: keeps the noir surface color behind translucent system bars. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="Overdraw"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/noir_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/noir_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textColor="@color/noir_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/noir_header_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/noir_text_tertiary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <EditText
        android:id="@+id/noir_search_input"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_noir_search"
        android:drawableStart="@drawable/ic_search"
        android:drawableTint="@color/noir_text_tertiary"
        android:drawablePadding="10dp"
        android:paddingHorizontal="14dp"
        android:hint="@string/settings_search_hint"
        android:textColorHint="@color/noir_text_tertiary"
        android:textColor="@color/noir_text"
        android:textSize="15sp"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:maxLines="1"
        android:singleLine="true"
        android:importantForAutofill="no" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/noir_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls" />

</LinearLayout>
