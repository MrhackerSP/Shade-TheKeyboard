<?xml version="1.0" encoding="utf-8"?>
<!--
  Shade settings — Gboard-style.
  A pitch-black canvas with a slim top bar (round back button + inline title),
  an optional pinned search field (home only) and one RecyclerView that shows
  either the grouped category cards (home) or the cards of one settings page.
-->
<!-- Explicit background: keeps the noir surface color behind translucent system bars. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="Overdraw"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/noir_background"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp">

        <ImageButton
            android:id="@+id/noir_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/settings_back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            android:tint="@color/noir_text"
            android:visibility="gone" />

        <TextView
            android:id="@+id/noir_header_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="72dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/settings_title"
            android:textColor="@color/noir_text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/noir_header_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="20dp"
            android:textColor="@color/noir_text_tertiary"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <EditText
        android:id="@+id/noir_search_input"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_noir_search"
        android:drawableStart="@drawable/ic_search"
        android:drawableTint="@color/noir_text_tertiary"
        android:drawablePadding="10dp"
        android:paddingHorizontal="16dp"
        android:hint="@string/settings_search_hint"
        android:textColorHint="@color/noir_text_tertiary"
        android:textColor="@color/noir_text"
        android:textSize="15sp"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:maxLines="1"
        android:singleLine="true"
        android:importantForAutofill="no" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/noir_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls" />

</LinearLayout>
