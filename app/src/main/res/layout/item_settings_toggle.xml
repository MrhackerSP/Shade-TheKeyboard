<?xml version="1.0" encoding="utf-8"?>
<!-- Toggle row: icon + title/subtitle + MaterialSwitch. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_settings_row_m3"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp"
    android:minHeight="60dp">

    <FrameLayout
        android:id="@+id/toggle_icon_badge"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_badge_m3"
        android:visibility="gone">

        <ImageView
            android:id="@+id/toggle_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_m3_keyboard" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="0dp">

        <TextView
            android:id="@+id/toggle_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/settings_row_title"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/toggle_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/settings_row_subtitle"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginTop="1dp" />
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/toggle_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false" />
</LinearLayout>
