<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsible section header: uppercase micro-label + rotating chevron. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/noir_section_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAllCaps="true"
        android:textColor="@color/noir_text_tertiary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.18" />

    <ImageView
        android:id="@+id/noir_section_arrow"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_settings_arrow"
        app:tint="@color/noir_text_tertiary"
        android:importantForAccessibility="no" />

</LinearLayout>
