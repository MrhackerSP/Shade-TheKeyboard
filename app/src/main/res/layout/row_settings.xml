<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/settings_row_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_settings_icon"
        android:contentDescription="@null"
        android:padding="10dp"
        app:tint="@color/settings_icon_tint" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/settings_row_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/settings_title"
            android:textSize="16sp"
            android:textStyle="normal"
            android:letterSpacing="0.01" />

        <TextView
            android:id="@+id/settings_row_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/settings_subtitle"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/settings_row_chevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="›"
        android:textColor="@color/settings_chevron"
        android:textSize="28sp" />
</merge>
