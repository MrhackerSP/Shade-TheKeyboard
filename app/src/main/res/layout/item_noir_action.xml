<?xml version="1.0" encoding="utf-8"?>
<!-- Action row: title (+optional subtitle). Opens a dialog/screen or runs a command. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="Overdraw"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="2dp"
    android:minHeight="64dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/noir_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/noir_text"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/noir_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/noir_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
