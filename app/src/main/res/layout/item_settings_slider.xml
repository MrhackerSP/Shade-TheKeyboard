<?xml version="1.0" encoding="utf-8"?>
<!-- Slider row: icon + title + value chip, then slider below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_settings_row_m3"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/slider_icon_badge"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_badge_m3"
            android:visibility="gone">

            <ImageView
                android:id="@+id/slider_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_m3_keyboard" />
        </FrameLayout>

        <TextView
            android:id="@+id/slider_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/settings_row_title"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Value chip -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp">

            <TextView
                android:id="@+id/slider_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_value_chip_m3"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:textColor="@color/m3_on_primary_container"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="56dp"
        android:valueFrom="0"
        android:valueTo="100"
        android:stepSize="1" />
</LinearLayout>
