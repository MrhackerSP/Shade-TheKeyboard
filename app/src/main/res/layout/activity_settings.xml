        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_header_title"
            android:textColor="@color/settings_title"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.01" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="28dp"
            android:text="@string/settings_header_subtitle"
            android:textColor="@color/settings_subtitle"
            android:textSize="14sp" />

        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_section_general" />

