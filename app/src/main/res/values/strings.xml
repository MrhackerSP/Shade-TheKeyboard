    <!-- Training data contribution -->
    <string name="pref_contribute">Keep local learning snapshots</string>
    <string name="pref_contribute_sum">Once a day Shade saves a snapshot of your learned words and word-pair counts in the app\'s private storage, so you can export it later. Nothing is ever uploaded: Shade has no internet permission. Snapshots can reveal what you type, so treat exports as personal data. Turn off to stop and delete snapshots.</string>
