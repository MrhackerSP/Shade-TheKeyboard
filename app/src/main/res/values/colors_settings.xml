<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 color tokens for the Shade settings UI.
  Light palette — derived from a #3B6FD4 seed (matches Shade's accent blue).
  All tokens map to M3 color roles used by MaterialSwitch, Slider, MaterialCardView, etc.
-->
<resources>
    <!-- Primary -->
    <color name="m3_primary">#3B6FD4</color>
    <color name="m3_on_primary">#FFFFFF</color>
    <color name="m3_primary_container">#D7E3FF</color>
    <color name="m3_on_primary_container">#001A41</color>

    <!-- Secondary (warm amber for accent contrast — matches Shade's settings_accent) -->
    <color name="m3_secondary">#B06800</color>
    <color name="m3_on_secondary">#FFFFFF</color>
    <color name="m3_secondary_container">#FFDDB3</color>
    <color name="m3_on_secondary_container">#3A2200</color>

    <!-- Tertiary (purple for visual variety) -->
    <color name="m3_tertiary">#7C5800</color>
    <color name="m3_on_tertiary">#FFFFFF</color>
    <color name="m3_tertiary_container">#FFDEA0</color>
    <color name="m3_on_tertiary_container">#281800</color>

    <!-- Error -->
    <color name="m3_error">#BA1A1A</color>
    <color name="m3_on_error">#FFFFFF</color>
    <color name="m3_error_container">#FFDAD6</color>
    <color name="m3_on_error_container">#410002</color>

    <!-- Surfaces -->
    <color name="m3_background">#FDFBFF</color>
    <color name="m3_on_background">#1A1B1F</color>
    <color name="m3_surface">#FDFBFF</color>
    <color name="m3_on_surface">#1A1B1F</color>
    <color name="m3_surface_variant">#E1E2EC</color>
    <color name="m3_on_surface_variant">#44474F</color>
    <color name="m3_surface_container">#EFEDF3</color>
    <color name="m3_surface_container_high">#E9E8EC</color>
    <color name="m3_surface_container_highest">#E3E2E8</color>
    <color name="m3_surface_bright">#FDFBFF</color>
    <color name="m3_surface_dim">#DCDADF</color>

    <!-- Outline -->
    <color name="m3_outline">#74777F</color>
    <color name="m3_outline_variant">#C4C6D0</color>

    <!-- Inverse -->
    <color name="m3_inverse_surface">#2F3036</color>
    <color name="m3_inverse_on_surface">#F0F0F7</color>
    <color name="m3_inverse_primary">#AAC7FF</color>

    <!-- Category icon badge colors (cycled by index % 3) -->
    <color name="settings_badge_0_bg">@color/m3_primary_container</color>
    <color name="settings_badge_0_fg">@color/m3_on_primary_container</color>
    <color name="settings_badge_1_bg">@color/m3_secondary_container</color>
    <color name="settings_badge_1_fg">@color/m3_on_secondary_container</color>
    <color name="settings_badge_2_bg">@color/m3_tertiary_container</color>
    <color name="settings_badge_2_fg">@color/m3_on_tertiary_container</color>

    <!-- Search pill -->
    <color name="search_pill_bg">@color/m3_surface_container_high</color>
    <color name="search_pill_bg_focused">@color/m3_primary_container</color>
    <color name="search_pill_text">@color/m3_on_surface</color>
    <color name="search_pill_hint">@color/m3_on_surface_variant</color>

    <!-- Section card -->
    <color name="settings_card_bg">@color/m3_surface_container</color>
    <color name="settings_card_stroke">@android:color/transparent</color>
    <color name="settings_row_bg">@color/m3_surface_bright</color>
    <color name="settings_divider">@color/m3_outline_variant</color>
    <color name="settings_section_title">@color/m3_primary</color>
    <color name="settings_row_title">@color/m3_on_surface</color>
    <color name="settings_row_subtitle">@color/m3_on_surface_variant</color>
</resources>
