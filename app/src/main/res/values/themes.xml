<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">#000000</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">#FFFFFF</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:textColorPrimary">#F5F5F5</item>
        <item name="android:textColorSecondary">#8E8E8E</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorControlNormal">#777777</item>
        <item name="colorControlActivated">#FFFFFF</item>
        <item name="colorControlHighlight">#22FFFFFF</item>
        <item name="preferenceTheme">@style/ShadePreferenceTheme</item>
        <item name="alertDialogTheme">@style/ShadeDialogTheme</item>
    </style>

    <style name="ShadePreferenceTheme" parent="PreferenceThemeOverlay">
        <item name="android:textColorPrimary">#F5F5F5</item>
        <item name="android:textColorSecondary">#8E8E8E</item>
        <item name="colorAccent">#FFFFFF</item>
        <item name="colorControlActivated">#FFFFFF</item>
        <item name="colorControlHighlight">#22FFFFFF</item>
    </style>

    <style name="SettingsRowStyle">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="android:background">@drawable/bg_settings_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">72dp</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">18dp</item>
        <item name="android:background">@drawable/bg_settings_card</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SettingsSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/settings_section</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">70dp</item>
        <item name="android:background">@color/settings_divider</item>
    </style>
    <style name="ShadeDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">#000000</item>
        <item name="android:textColorPrimary">#F5F5F5</item>
        <item name="android:textColorSecondary">#8E8E8E</item>
        <item name="colorAccent">#FFFFFF</item>
        <item name="colorControlNormal">#777777</item>
        <item name="colorControlActivated">#FFFFFF</item>
    </style>
</resources>
