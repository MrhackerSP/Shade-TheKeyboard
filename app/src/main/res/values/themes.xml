<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Custom attributes for settings theming -->
    <attr name="settingsCardColor" format="color" />
    <attr name="settingsCardStrokeColor" format="color" />
    <attr name="settingsIconBg" format="color" />
    <attr name="settingsIconTint" format="color" />

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/settings_accent</item>
        <item name="colorPrimaryDark">@color/settings_background</item>
        <item name="colorAccent">@color/settings_accent</item>
        <item name="android:colorBackground">@color/settings_background</item>
        <item name="android:textColorPrimary">@color/settings_title</item>
        <item name="android:textColorSecondary">@color/settings_subtitle</item>
        <item name="android:statusBarColor">@color/settings_background</item>
        <item name="android:navigationBarColor">@color/settings_background</item>
        <item name="android:windowBackground">@color/settings_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorControlNormal">@color/settings_chevron</item>
        <item name="colorControlActivated">@color/settings_accent</item>
        <item name="colorControlHighlight">#22FFFFFF</item>
        <item name="preferenceTheme">@style/ShadePreferenceTheme</item>
        <item name="alertDialogTheme">@style/ShadeDialogTheme</item>
        <!-- Custom settings attrs -->
        <item name="settingsCardColor">@color/settings_card</item>
        <item name="settingsCardStrokeColor">@color/settings_card_stroke</item>
        <item name="settingsIconBg">@color/settings_icon_background</item>
        <item name="settingsIconTint">@color/settings_icon_tint</item>
    </style>

    <style name="ShadePreferenceTheme" parent="PreferenceThemeOverlay">
        <item name="android:textColorPrimary">@color/settings_title</item>
        <item name="android:textColorSecondary">@color/settings_subtitle</item>
        <item name="colorAccent">@color/settings_accent</item>
        <item name="colorControlActivated">@color/settings_accent</item>
        <item name="colorControlHighlight">#22FFFFFF</item>
    </style>

    <style name="ShadeDialogTheme" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <!-- Noir: matches the redesigned settings; only settings dialogs use this. -->
        <item name="android:colorBackground">@color/noir_sheet</item>
        <item name="android:textColorPrimary">@color/noir_text</item>
        <item name="android:textColorSecondary">@color/noir_text_secondary</item>
        <item name="colorAccent">@color/noir_text</item>
        <item name="colorControlNormal">@color/noir_control_normal</item>
        <item name="colorControlActivated">@color/noir_text</item>
    </style>

    <!-- ──────── Noir Settings Theme ────────
         Applied to SettingsActivity via android:theme in the manifest.
         Pitch-black surfaces, white controls, gray secondary text. The M3
         parent provides component defaults (MaterialSwitch, Slider,
         MaterialButtonToggleGroup); the color roles here make every one of
         them render monochrome (white = on, black = off). -->
    <style name="ShadeSettings" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/noir_text</item>
        <item name="colorOnPrimary">@color/noir_on_button</item>
        <item name="colorPrimaryContainer">@color/noir_field</item>
        <item name="colorOnPrimaryContainer">@color/noir_text</item>
        <item name="colorSecondary">@color/noir_text</item>
        <item name="colorOnSecondary">@color/noir_on_button</item>
        <item name="colorSecondaryContainer">@color/noir_field</item>
        <item name="colorOnSecondaryContainer">@color/noir_text</item>
        <item name="colorTertiary">@color/noir_text</item>
        <item name="colorOnTertiary">@color/noir_on_button</item>
        <item name="colorTertiaryContainer">@color/noir_field</item>
        <item name="colorOnTertiaryContainer">@color/noir_text</item>
        <item name="colorError">#9E9E9E</item>
        <item name="colorOnError">@color/noir_on_button</item>
        <item name="colorErrorContainer">@color/noir_field</item>
        <item name="colorOnErrorContainer">@color/noir_text</item>
        <item name="android:colorBackground">@color/noir_background</item>
        <item name="colorOnBackground">@color/noir_text</item>
        <item name="colorSurface">@color/noir_background</item>
        <item name="colorOnSurface">@color/noir_text</item>
        <item name="colorSurfaceVariant">@color/noir_field</item>
        <item name="colorOnSurfaceVariant">@color/noir_text_secondary</item>
        <item name="colorSurfaceContainerLowest">#0A0A0A</item>
        <item name="colorSurfaceContainerLow">#0F0F0F</item>
        <item name="colorSurfaceContainer">#141414</item>
        <item name="colorSurfaceContainerHigh">#1F1F1F</item>
        <item name="colorSurfaceContainerHighest">#2A2A2A</item>
        <item name="colorSurfaceInverse">@color/noir_text</item>
        <item name="colorOnSurfaceInverse">@color/noir_on_button</item>
        <item name="colorOutline">@color/noir_control_normal</item>
        <item name="colorOutlineVariant">@color/noir_divider</item>
        <item name="android:statusBarColor">@color/noir_background</item>
        <item name="android:navigationBarColor">@color/noir_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/noir_background</item>
        <item name="colorControlNormal">@color/noir_control_normal</item>
        <item name="colorControlActivated">@color/noir_text</item>
        <item name="colorControlHighlight">#22FFFFFF</item>
        <!-- MaterialSwitch + Slider + MaterialButtonToggleGroup use these -->
        <item name="materialSwitchStyle">@style/Widget.Material3.CompoundButton.Switch</item>
        <item name="sliderStyle">@style/Widget.Material3.Slider</item>
    </style>

    <!-- Slide-up/down window animation for the color picker sheet. -->
    <style name="SheetDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_slide_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_slide_out</item>
    </style>
</resources>
