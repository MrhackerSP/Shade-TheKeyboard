+/** The nine palette slots Shade's renderer consumes. Pure, no android deps. */
+data class KbTheme(
+    val bg: Int,
+    val key: Int,
+    val keyFn: Int,
+    val pressed: Int,
+    val text: Int,
+    val hint: Int,
+    val accent: Int,
+    val accentText: Int,
+    val popupBg: Int
+)
+
+/**
+ * Manual color overrides — Expressive's `color_*` rows. `null` = "auto",
+ * i.e. keep the base theme's slot. Built by Theme.kt from the prefs.
+ */
+data class ThemeOverrides(
+    val bg: Int? = null,
+    val key: Int? = null,
+    val keyFn: Int? = null,
+    val text: Int? = null,
+    val accent: Int? = null
