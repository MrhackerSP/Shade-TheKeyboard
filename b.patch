+        ),
+        DesignPreset(
+            "neumorph",
+            palette(0xFFE6EAF1.toInt(), 0xFFE6EAF1.toInt(), 0xFFE6EAF1.toInt(), 0xFF39404F.toInt(), 0xFF6B7FF0.toInt()),
+            palette(0xFF262A32.toInt(), 0xFF262A32.toInt(), 0xFF262A32.toInt(), 0xFFDDE2EC.toInt(), 0xFF7C8EFF.toInt())
+        ),
+        DesignPreset(
+            "samsung",
