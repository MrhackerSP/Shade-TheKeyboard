+            key = k,
+            keyFn = keyFn ?: base.keyFn,
+            pressed = ColorMath.blendArgb(k, acc, 0.35f),
+            text = t,
+            hint = ColorMath.withAlpha(t, 0x99),
+            accent = acc,
+            accentText = ColorMath.contrastTextColor(acc),
+            popupBg = k
+        )
+    }
