+package com.shade.keyboard.engine
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Contract tests for the 83-float input vector of ranking/ranker_en.tflite.
+ *
+ * The full-vector fixtures below were generated by decoding the model's
+ * flatbuffer op-by-op and running the EXACT contract vectors through LiteRT on
+ * the on-device asset (plus an exact numpy reimplementation as oracle). The
+ * recorded oracle scores are comments: the JVM cannot execute the hybrid-int8
+ * TFLite graph, so what is pinned here is the vector layout — the thing this
+ * extractor owns. A vector that matches these fixtures bit-for-bit feeds the
+ * model exactly as the decoder intended.
+ */
+class RankingFeatureExtractorTest {
+
+    companion object {
+        /** z-scored positions and population means (the model's own constants). */
+        val IMPUTED = linkedMapOf(
+            1 to -11.868727684020996f, 3 to -16.108646392822266f,
+            8 to -11.860713005065918f, 9 to 3.7086970806121826f,
+            10 to 4.737763404846191f, 12 to 0.1682620793581009f,
+            13 to 0.07510673254728317f, 15 to 0.19201767444610596f,
+            16 to 0.10502961277961731f, 17 to 0.5961264371871948f,
+            22 to 0.529959499835968f, 27 to 1.072770118713379f,
+            28 to 0.04370403662323952f, 29 to 0.005614586174488068f,
+            30 to 0.24214617908000946f, 31 to 0.031911496073007584f,
+            32 to 1.3719323873519897f, 33 to 95.1851806640625f,
+            34 to 134.48724365234375f, 36 to 0.10597605258226395f,
+            37 to 0.15462397038936615f, 38 to 2.081317663192749f,
+            39 to 0.7217158675193787f, 40 to 0f,
+            41 to 0.0007014714647084475f, 42 to 0.0002284557995153591f,
+            43 to 0.011135885491967201f, 44 to 0.09498659521341324f,
+            45 to 0.0010307022603228688f
+        )
+
+        /** Pass-through positions with no Shade-side meaning — must stay 0. */
+        val PASS_THROUGH_ZERO = intArrayOf(
+            0, 2, 4, 5, 6, 7, 11, 14, 18, 19, 20, 21, 23, 24, 25, 26,
+            35, 48, 49, 50, 51
+        )
+
+        /** Positions 52..81 plus 82: char regions + type code, checked per test. */
+        fun assertImputedAndZero(f: FloatArray) {
+            assertEquals(83, f.size)
+            for ((pos, mean) in IMPUTED) assertEquals("imputed pos $pos", mean, f[pos], 0f)
+            for (p in PASS_THROUGH_ZERO) assertEquals("pass-through pos $p must stay 0", 0f, f[p], 0f)
+        }
+    }
+
+    private fun assertVec(expected: FloatArray, actual: FloatArray) {
+        assertEquals("length", expected.size, actual.size)
+        for (i in expected.indices) assertEquals("position $i", expected[i], actual[i], 0f)
+    }
+
+    // ------------------------------------------------------------------
+    // Layout pillars
+    // ------------------------------------------------------------------
+
+    @Test
+    fun neutralFillUsesPopulationMeans_notZeros() {
+        val f = RankingFeatureExtractor.extract("hello")
+        assertImputedAndZero(f)
+        // The old extractor fed raw zeros here; the model's in-model z-score
+        // then sat at −4σ (positions 33/34) and the network collapsed into its
+        // all-zero no-op zone. Mean fill keeps it live.
+    }
+
+    @Test
+    fun charSequencesAreCandidateAndTypedAscii_zeroPadded() {
+        val f = RankingFeatureExtractor.extract("hello", "helo")
+        assertImputedAndZero(f)
+        // A = candidate 'hello' at slots 52..56
+        assertEquals(104f, f[52], 0f); assertEquals(101f, f[53], 0f)
+        assertEquals(108f, f[54], 0f); assertEquals(108f, f[55], 0f)
+        assertEquals(111f, f[56], 0f)
+        for (i in 57..66) assertEquals("A padding $i", 0f, f[i], 0f)
+        // B = typed 'helo' at slots 67..70
+        assertEquals(104f, f[67], 0f); assertEquals(101f, f[68], 0f)
+        assertEquals(108f, f[69], 0f); assertEquals(111f, f[70], 0f)
+        for (i in 71..81) assertEquals("B padding $i", 0f, f[i], 0f)
+        assertEquals(RankingFeatureExtractor.TYPE_WORD.toFloat(), f[82], 0f)
+    }
+
+    @Test
+    fun candidatesAreLowercased() {
+        assertVec(
+            RankingFeatureExtractor.extract("Hello", "HELo"),
+            RankingFeatureExtractor.extract("hello", "helo")
+        )
+    }
+
+    @Test
+    fun outOfTableCodesAreDropped_notClamped() {
+        // Cyrillic (0x430+) and Latin-1 accents exceed the 123-row char table
+        // (codes 0..122); they must be dropped, leaving compacted sequences.
+        val f = RankingFeatureExtractor.extract("привет", "héllo")
+        for (i in 52..66) assertEquals("Cyrillic candidate drops to padding $i", 0f, f[i], 0f)
+        // 'héllo' → h, (é dropped), l, l, o — compacted, not position-preserving
+        assertEquals(104f, f[67], 0f)
+        assertEquals(108f, f[68], 0f)
+        assertEquals(108f, f[69], 0f)
+        assertEquals(111f, f[70], 0f)
+        assertEquals(0f, f[71], 0f)
+    }
+
+    @Test
+    fun apostropheIsWithinTableAndKept() {
+        val f = RankingFeatureExtractor.extract("don't", "dont")
+        assertEquals(100f, f[52], 0f)  // d
+        assertEquals(111f, f[53], 0f)  // o
+        assertEquals(110f, f[54], 0f)  // n
+        assertEquals(39f, f[55], 0f)   // '
+        assertEquals(116f, f[56], 0f)  // t
+    }
+
+    @Test
+    fun longWordsTruncateAtFifteenSlots() {
+        val f = RankingFeatureExtractor.extract("internationalization", "internationalization")
+        assertEquals(105f, f[52], 0f)   // i
+        assertEquals(122f, f[66], 0f)   // z (15th char)
+        assertEquals(0f, f[51], 0f)     // no bleed into x[51]
+        for (i in 67..81) assertTrue("B truncated fills to 81", f[i] != 0f)
+    }
+
+    @Test
+    fun countsAreRaw_andCapped() {
+        val f = RankingFeatureExtractor.extract("the", "te", userUnigramCount = 500, userBigramCount = 250)
+        assertEquals(100f, f[46], 0f)
+        assertEquals(100f, f[47], 0f)
+        val g = RankingFeatureExtractor.extract("the", "te", userUnigramCount = 3, userBigramCount = 1)
+        assertEquals(3f, g[46], 0f)
+        assertEquals(1f, g[47], 0f)
+        // Negative counts are clamped, never fed (log(v+1) requires v >= -1).
+        val h = RankingFeatureExtractor.extract("the", "te", userUnigramCount = -4, userBigramCount = -4)
+        assertEquals(0f, h[46], 0f)
+        assertEquals(0f, h[47], 0f)
+    }
+
+    @Test
+    fun typeCodeIsCoercedToEnumRange() {
+        assertEquals(13f, RankingFeatureExtractor.extract("x", typeCode = 13)[82], 0f)
+        assertEquals(33f, RankingFeatureExtractor.extract("x", typeCode = 40)[82], 0f)
+        assertEquals(0f, RankingFeatureExtractor.extract("x", typeCode = -5)[82], 0f)
+    }
+
+    @Test
+    fun typedEqualsCandidateIsLiveWithImputedScalars() {
+        // In the zero-scalar regime identical sequences scored 0.0 — an output
+        // CLIPPING artifact (p <= s), not a designed match signal. With the
+        // neutral mean fill the pair scores normally (oracle: +0.585230), so
+        // this wiring must NOT special-case equality.
+        val f = RankingFeatureExtractor.extract("hello", "hello", userUnigramCount = 3, userBigramCount = 1)
+        for (i in 0..14) assertEquals("A/B identical", f[52 + i], f[67 + i], 0f)
+        assertEquals(3f, f[46], 0f)
+    }
+
+    // ------------------------------------------------------------------
+    // Full-vector fixtures (oracle outputs recorded from LiteRT on-device file)
+    // ------------------------------------------------------------------
+
+    @Test
+    fun fixtureHelloVsHeloWithCounts() {
+        val f = RankingFeatureExtractor.extract("hello", "helo", userUnigramCount = 3, userBigramCount = 1)
+        // Oracle (LiteRT on ranking/ranker_en.tflite): +0.593883
+        assertVec(floatArrayOf(
+            0f, -11.868727684020996f, 0f, -16.108646392822266f, 0f,
+            0f, 0f, 0f, -11.860713005065918f, 3.7086970806121826f,
+            4.737763404846191f, 0f, 0.1682620793581009f, 0.07510673254728317f, 0f,
+            0.19201767444610596f, 0.10502961277961731f, 0.5961264371871948f, 0f, 0f,
+            0f, 0f, 0.529959499835968f, 0f, 0f,
+            0f, 0f, 1.072770118713379f, 0.04370403662323952f, 0.005614586174488068f,
+            0.24214617908000946f, 0.031911496073007584f, 1.3719323873519897f, 95.1851806640625f, 134.48724365234375f,
+            0f, 0.10597605258226395f, 0.15462397038936615f, 2.081317663192749f, 0.7217158675193787f,
+            0f, 0.0007014714647084475f, 0.0002284557995153591f, 0.011135885491967201f, 0.09498659521341324f,
+            0.0010307022603228688f, 3f, 1f, 0f, 0f,
+            0f, 0f, 104f, 101f, 108f,
+            108f, 111f, 0f, 0f, 0f,
+            0f, 0f, 0f, 0f, 0f,
+            0f, 0f, 104f, 101f, 108f,
+            111f, 0f, 0f, 0f, 0f,
+            0f, 0f, 0f, 0f, 0f,
+            0f, 0f, 0f
+        ), f)
+    }
+
+    @Test
+    fun fixtureTruncationBeyondFifteenChars() {
+        val f = RankingFeatureExtractor.extract("internationalization", "internationalization", userUnigramCount = 1)
+        // Oracle (LiteRT on ranking/ranker_en.tflite): +0.182866
+        assertVec(floatArrayOf(
+            0f, -11.868727684020996f, 0f, -16.108646392822266f, 0f,
+            0f, 0f, 0f, -11.860713005065918f, 3.7086970806121826f,
+            4.737763404846191f, 0f, 0.1682620793581009f, 0.07510673254728317f, 0f,
+            0.19201767444610596f, 0.10502961277961731f, 0.5961264371871948f, 0f, 0f,
+            0f, 0f, 0.529959499835968f, 0f, 0f,
+            0f, 0f, 1.072770118713379f, 0.04370403662323952f, 0.005614586174488068f,
+            0.24214617908000946f, 0.031911496073007584f, 1.3719323873519897f, 95.1851806640625f, 134.48724365234375f,
+            0f, 0.10597605258226395f, 0.15462397038936615f, 2.081317663192749f, 0.7217158675193787f,
+            0f, 0.0007014714647084475f, 0.0002284557995153591f, 0.011135885491967201f, 0.09498659521341324f,
+            0.0010307022603228688f, 1f, 0f, 0f, 0f,
+            0f, 0f, 105f, 110f, 116f,
+            101f, 114f, 110f, 97f, 116f,
+            105f, 111f, 110f, 97f, 108f,
+            105f, 122f, 105f, 110f, 116f,
+            101f, 114f, 110f, 97f, 116f,
+            105f, 111f, 110f, 97f, 108f,
+            105f, 122f, 0f
+        ), f)
+    }
+}
+
+/** Raw count accessors added for the neural ranking features. */
+class SessionBigramBoostCountsTest {
+
+    @Test
+    fun rawCountsReflectObservations() {
+        val b = SessionBigramBoost()
+        b.observeBigram("good", "morning")
+        b.observeBigram("good", "morning")
+        b.observeBigram("good", "morning")
+        assertEquals(3, b.bigramCount("good", "morning"))
+        assertEquals(3, b.unigramCount("morning"))
+        // observeBigram counts only the FOLLOWING word's unigram; the prev
+        // word gets a count only when observed as a word in its own right.
+        assertEquals(0, b.unigramCount("good"))
+        assertEquals(0, b.bigramCount("night", "morning"))
+        assertEquals(0, b.bigramCount(null, "morning"))
+        assertEquals(0, b.bigramCount("", "morning"))
+    }
+
+    @Test
+    fun countsAreNormalizedInsensitiveAndSessionScoped() {
+        val b = SessionBigramBoost()
+        b.observeBigram("Good", "Morning")
+        assertEquals(1, b.bigramCount("GOOD", " morning "))
+        b.clear()
+        assertEquals(0, b.bigramCount("good", "morning"))
+        assertEquals(0, b.unigramCount("morning"))
+    }
+}
